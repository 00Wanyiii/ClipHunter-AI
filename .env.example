# Copy to .env for local development only. Never commit .env.
# Prefer official OAuth connections / secret stores for no-code services.

AIRTABLE_BASE_ID=
AIRTABLE_API_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional custom service integrations — only populate after selecting
# a provider and verifying its official API documentation.
CLIPPING_PROVIDER=
CLIPPING_PROVIDER_API_KEY=
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_PROVIDER_API_KEY=

# Safety defaults
PUBLISHING_ENABLED=false
REQUIRE_HUMAN_APPROVAL=true
